<com.google.android.setupdesign.GlifLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/setup_wizard_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        style="@style/SudContentFrame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="@dimen/setup_card_margin_horizontal"
            android:paddingTop="@dimen/setup_card_margin_top"
            android:paddingEnd="@dimen/setup_card_margin_horizontal"
            android:paddingBottom="@dimen/setup_card_margin_bottom">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/setup_onboarding_card_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/setup_card_padding">

                <org.lineageos.setupwizard.widget.LocalePicker
                    android:id="@+id/locale_list"
                    style="@style/LocaleWidget.Material.LocalePicker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="true"
                    android:focusableInTouchMode="true" />
            </LinearLayout>
        </FrameLayout>

        <org.lineageos.setupwizard.NavigationLayout
            android:id="@+id/navigation_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>
</com.google.android.setupdesign.GlifLayout>
