<com.google.android.setupdesign.GlifLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/setup_wizard_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ProgressBar
            android:id="@+id/progressBar1"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:indeterminateOnly="true"
            android:paddingStart="0dp"
            android:paddingEnd="0dp" />

        <FrameLayout
            android:id="@+id/page"
            style="@style/SudContentFrame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="@dimen/setup_card_margin_horizontal"
            android:paddingTop="@dimen/setup_card_margin_top"
            android:paddingEnd="@dimen/setup_card_margin_horizontal"
            android:paddingBottom="@dimen/setup_card_margin_bottom">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/setup_onboarding_card_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/setup_card_padding">

                <TextView
                    style="@style/SetupOnboardingCardBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/loading" />
            </LinearLayout>
        </FrameLayout>

        <com.google.android.setupdesign.view.NavigationBar
            android:id="@+id/navigation_bar"
            style="@style/SudNavBarTheme"
            android:layout_width="match_parent"
            android:layout_height="@dimen/sud_navbar_height" />

    </LinearLayout>
</com.google.android.setupdesign.GlifLayout>
